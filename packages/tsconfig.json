{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "declaration": true
  },
  "include": ["core/**/*.ts", "storage/**/*.ts", "executor-codex/**/*.ts", "service/**/*.ts", "integrations-github/**/*.ts", "mcp/**/*.ts", "tests/**/*.ts"]
}
